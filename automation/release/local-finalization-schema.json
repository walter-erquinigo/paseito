{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ready",
    "changeId",
    "commitMessage",
    "files",
    "checks",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ready": { "type": "boolean" },
    "changeId": { "type": "string" },
    "commitMessage": { "type": "string" },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "command": { "type": "string" },
          "result": { "enum": ["passed", "failed", "not-run"] }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
