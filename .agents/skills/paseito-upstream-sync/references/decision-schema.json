{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "upstreamTag",
    "upstreamCommit",
    "candidateCommit",
    "blocked",
    "blockers",
    "features",
    "verificationRecommendations"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "upstreamTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "upstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "blocked": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "verificationRecommendations": { "type": "array", "items": { "type": "string" } },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "confidence",
          "summary",
          "evidence",
          "contractChecks",
          "residualWork"
        ],
        "properties": {
          "id": { "type": "string" },
          "classification": {
            "enum": ["carry_forward", "adapt", "upstream_complete", "blocked"]
          },
          "confidence": { "enum": ["certain", "likely", "guessing"] },
          "summary": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference", "explanation"],
              "properties": {
                "kind": { "enum": ["commit", "file", "test", "command"] },
                "reference": { "type": "string" },
                "explanation": { "type": "string" }
              }
            }
          },
          "contractChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "result"],
              "properties": {
                "command": { "type": "string" },
                "result": { "enum": ["passed", "failed", "not_run"] }
              }
            }
          },
          "residualWork": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
